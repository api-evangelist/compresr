          "id": "635d224a-1afe-4318-a99d-cda3b723919f",
          "name": "Get Usage Stats",
          "request": {
            "name": "Get Usage Stats",
            "description": {
              "content": "Get comprehensive usage statistics with time series.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "usage",
                "stats"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "period",
                  "value": "last_day",
                  "description": "Time period: last_day, last_week, last_month, last_90_days, last_year, current_month, custom"
                },
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<string>",
                  "description": "Start date for custom period (YYYY-MM-DD)"
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<string>",
                  "description": "End date for custom period (YYYY-MM-DD)"
                },
                {
                  "disabled": false,
                  "key": "group_by",
                  "value": "day",
                  "description": "Group by: hour or day"
                },
                {
                  "disabled": false,
                  "key": "api_key_id",
                  "value": "<string>",
                  "description": "Filter by specific API key ID"
                },
                {
                  "disabled": false,
                  "key": "model",
                  "value": "<string>",
                  "description": "Filter by specific model"
                },
                {
                  "disabled": false,
                  "key": "include_per_key",
                  "value": "false",
                  "description": "When true (and no api_key_id filter), include per-key breakdown in one response."
                },
                {
                  "disabled": false,
                  "key": "skip_cache",
                  "value": "false",
                  "description": "Force-drain the Redis usage stream so pending events land in usage_logs before reading. Use when the user clicks refresh."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
