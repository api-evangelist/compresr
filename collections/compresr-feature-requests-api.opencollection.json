{
  "opencollection": "1.0.0",
  "info": {
    "name": "Compresr Platform Admin Feature Requests API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Feature Requests",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Submit Feature Request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/feature/request",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submit a feature request.\n\n- No authentication required\n- Validates email, subject, and description\n- Stores request for admin review\n- Rate limited: 5 requests per hour per IP"
        },
        {
          "info": {
            "name": "List Feature Requests",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/feature/admin/requests",
            "params": [
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by status"
              },
              {
                "name": "priority",
                "value": "",
                "type": "query",
                "description": "Filter by priority"
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Search in email, subject, or description"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Max results"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Pagination offset"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List all feature requests with filtering.\n\n- Requires Support or Admin role\n- Supports filtering by status and priority\n- Supports search in email, subject, and description"
        },
        {
          "info": {
            "name": "Get Feature Request",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/feature/admin/requests/:request_id",
            "params": [
              {
                "name": "request_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a single feature request by ID.\n\n- Requires Support or Admin role"
        },
        {
          "info": {
            "name": "Update Feature Request",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/feature/admin/requests/:request_id",
            "params": [
              {
                "name": "request_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update a feature request status, priority, or notes.\n\n- Requires Admin role"
        },
        {
          "info": {
            "name": "Delete Feature Request",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/feature/admin/requests/:request_id",
            "params": [
              {
                "name": "request_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a feature request.\n\n- Requires Admin role\n- This action is permanent"
        }
      ]
    }
  ],
  "bundled": true
}