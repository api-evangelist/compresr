{
  "opencollection": "1.0.0",
  "info": {
    "name": "Compresr Platform Admin OAuth API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "OAuth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Authorize",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/oauth/authorize",
            "params": [
              {
                "name": "response_type",
                "value": "",
                "type": "query"
              },
              {
                "name": "client_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "redirect_uri",
                "value": "",
                "type": "query"
              },
              {
                "name": "code_challenge",
                "value": "",
                "type": "query"
              },
              {
                "name": "code_challenge_method",
                "value": "",
                "type": "query"
              },
              {
                "name": "state",
                "value": "",
                "type": "query"
              },
              {
                "name": "scope",
                "value": "",
                "type": "query"
              },
              {
                "name": "org",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Begin the authorization-code flow.\n\nOn success, redirect (302) to the frontend consent screen carrying the\nopaque ``request_id``. On validation failure, return a 400 JSON error\nrather than redirecting to an unvalidated URI."
        },
        {
          "info": {
            "name": "Get Authorize Request",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/oauth/authorize/request/:request_id",
            "params": [
              {
                "name": "request_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Return consent-screen render data for a pending authorization request."
        },
        {
          "info": {
            "name": "Authorize Decision",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/oauth/authorize/decision",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Record the user's approve/deny decision and return the loopback redirect."
        },
        {
          "info": {
            "name": "Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/oauth/token",
            "body": {
              "type": "form-urlencoded",
              "data": []
            }
          },
          "docs": "RFC 6749 token endpoint. Dispatches on ``grant_type`` and returns a\n``TokenResponse`` on success or an RFC 6749 JSON error envelope on failure."
        },
        {
          "info": {
            "name": "Device Authorization",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/oauth/device_authorization",
            "body": {
              "type": "form-urlencoded",
              "data": []
            }
          },
          "docs": "RFC 8628 device authorization endpoint."
        },
        {
          "info": {
            "name": "Device Decision",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/oauth/device/decision",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Record the user's approve/deny decision for a device authorization."
        }
      ]
    }
  ],
  "bundled": true
}