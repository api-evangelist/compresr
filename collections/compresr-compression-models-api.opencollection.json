{
  "opencollection": "1.0.0",
  "info": {
    "name": "Compresr Platform Admin Compression-Models API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Compression-Models",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Compression Models",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/compress/models",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "model_type",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List compression models; admin_only entries hidden for non-admins."
        },
        {
          "info": {
            "name": "Get Compression Model",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/compress/models/:model_id",
            "headers": [
              {
                "name": "X-API-Key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "model_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a specific model. 404 (not 403) for admin_only when non-admin, to avoid leaking existence."
        }
      ]
    }
  ],
  "bundled": true
}